{# expects: item #}
<div class="qty-row">
  <span class="qty-name" id="qn-{{ item.id }}">{{ item.name }}</span>
  <label class="qty-field">
    <span class="visually-hidden">{{ item.name }} quantity</span>
    <input type="number" name="{{ item.name }} — quantity" min="0" max="50" value="0" inputmode="numeric" aria-describedby="qn-{{ item.id }}">
  </label>
  {% if item.prices.length > 1 %}
  <label class="qty-size">
    <span class="visually-hidden">{{ item.name }} size</span>
    <select name="{{ item.name }} — size" aria-describedby="qn-{{ item.id }}">
      {% for p in item.prices %}<option>{{ p.label }}</option>{% endfor %}
    </select>
  </label>
  {% else %}
    <input type="hidden" name="{{ item.name }} — size" value="{{ item.prices[0].label }}">
    <span class="qty-unit">{{ item.prices[0].label }}</span>
  {% endif %}
</div>
